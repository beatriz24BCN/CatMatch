# Example env file - do NOT store real credentials here
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=catmatch
# Optional: you can set DATABASE_URL directly instead of the POSTGRES_* variables
# DATABASE_URL=postgresql://user:pass@db:5432/catmatch

# Seguridad y Autenticacion JWT (Opcional en desarrollo, Obligatoria en produccion)
# JWT_SECRET_KEY: Cadena secreta para firmar tokens HMAC-SHA256
JWT_SECRET_KEY=cambiar_por_un_secreto_largo_y_aleatorio_en_produccion
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES: Tiempo de vida del token en minutos
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# REMEMBER_ME_EXPIRE_DAYS: Duracion en dias de la sesion con «Recordarme»
REMEMBER_ME_EXPIRE_DAYS=30

# Recuperacion de contrasena por correo (SMTP). Sin SMTP_HOST, SMTP_FROM y
# FRONTEND_BASE_URL, POST /api/auth/password-reset/request responde 503 y no envia nada.
# No guardes credenciales reales en este archivo.
# FRONTEND_BASE_URL: URL publica del frontend (la del puerto 3000 en Codespaces), sin barra final
FRONTEND_BASE_URL=
SMTP_HOST=
# 587 con STARTTLS, 465 con SSL
SMTP_PORT=587
# starttls | ssl | none (none solo para servidores de prueba locales)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Remitente, p. ej. CatMatch <no-reply@tu-dominio.example>
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=10
# Caducidad del enlace (minutos) y espera minima entre solicitudes por cuenta (segundos)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_MIN_INTERVAL_SECONDS=60
# SOLO DESARROLLO: true guarda el enlace de recuperacion en un buzon en memoria del backend
# (sin enviar correo) y la pagina /auth/forgot-password muestra un boton para abrirlo.
# Solo funciona con env=dev o env=test; en cualquier otro entorno (p. ej. prod) se ignora.
PASSWORD_RESET_DEV_OUTBOX=false
