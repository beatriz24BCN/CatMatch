# Example environment variables for CatMatch (DO NOT commit real secrets)
# DATABASE_URL: PostgreSQL connection URL used by the backend.
#  Format example (Postgres): postgresql://user:password@localhost:5432/catmatch
#  If you don't have a DB yet, leave blank for now or use a local SQLite URL when appropriate.
DATABASE_URL=

# JWT_SECRET_KEY: secret used to sign JWT tokens. Keep this private and long (e.g. >=32 chars).
JWT_SECRET_KEY=

# AI_API_KEY: API key for the AI provider used by backend services (keep private).
AI_API_KEY=

# Notes:
# - Copy this file to a local `.env` and fill values before running the backend locally.
# - `.env` is ignored by git; do NOT store secrets in the repository.
