# Example env file - do NOT store real credentials here
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=catmatch
# Optional: you can set DATABASE_URL directly instead of the POSTGRES_* variables
# DATABASE_URL=postgresql://user:pass@db:5432/catmatch

# Seguridad y Autenticacion JWT (Opcional en desarrollo, Obligatoria en produccion)
# JWT_SECRET_KEY: Cadena secreta para firmar tokens HMAC-SHA256
JWT_SECRET_KEY=cambiar_por_un_secreto_largo_y_aleatorio_en_produccion
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES: Tiempo de vida del token en minutos
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
